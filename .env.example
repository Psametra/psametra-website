# Optional override of the approved default. Rebuild after changing this value.
NEXT_PUBLIC_CONTACT_EMAIL=psametratech@gmail.com

# Server-only admin authentication. Generate each value with `npm run admin:hash -- "password"`.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_CREDENTIALS_SECRET=replace-with-a-different-32-character-random-secret
ADMIN_ABDUR_PASSWORD_HASH=replace-with-generated-scrypt-hash
ADMIN_SAAD_PASSWORD_HASH=replace-with-generated-scrypt-hash

# Cloudinary stores the editable JSON content document and uploaded media.
CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
